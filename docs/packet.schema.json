        },
        "type": {
          "const": "channel",
          "title": "Type",
          "type": "string"
        },
        "node": {
          "const": "sniffer",
          "title": "Node",
          "type": "string"
        },
        "boot_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Boot Id",
          "type": "string"
        },
