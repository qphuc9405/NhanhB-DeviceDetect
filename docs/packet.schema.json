          "minimum": 0,
          "title": "Ts Us",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "channel": {
          "maximum": 13,
          "minimum": 1,
          "title": "Channel",
          "type": "integer"
        },
        "dwell_ms": {
          "maximum": 10000,
          "minimum": 100,
          "title": "Dwell Ms",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "type",
        "node",
        "boot_id",
        "ts_us",
        "seq",
        "channel",
        "dwell_ms"
      ],
      "title": "Channel",
      "type": "object"
    },
